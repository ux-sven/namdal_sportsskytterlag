---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { posts, url } from '../lib/site.js';
const latest = posts.slice(0, 3);
const sports = [
  { title: 'Baneskyting', org: 'NSF', img: '/images/bane.jpg', href: '/norges-sportsskytterforbund/', tilt: -5,
    text: 'Presisjon og hurtighet på 25 meter.' },
  { title: 'Feltskyting', org: 'NSF', img: '/images/felt.jpg', href: '/norges-sportsskytterforbund/', tilt: 3,
    text: 'Ukjente avstander i terrenget.' },
  { title: 'Dynamisk', org: 'DSSN', img: '/images/hero-dynamisk.jpg', href: '/dynamisk-sportsskyting/', tilt: -2,
    text: 'Handgun, Rifle og PCC i bevegelse.' },
  { title: 'Sikkerhetskurs', org: 'Start her', img: '/images/bergsmo.jpg', href: '/sikkerhetskurs/', tilt: 6, featured: true,
    text: 'Alle nye skyttere begynner med kurset vårt.' },
];
const ranges = [
  { name: 'Bergsmo', where: 'Innendørs · vinter', img: '/images/bergsmo.jpg', href: '/om-2/', tilt: -4,
    text: '25-metersbane med elektroniske skiver.' },
  { name: 'Øysletta', where: 'Utendørs · sommer', img: '/images/oysletta.jpg', href: '/oysletta-skytterbane/', tilt: 3,
    text: 'Ca. 30 km fra Namsos – felt og dynamisk.' },
];
const pin = '<svg class="pin" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="5" fill="currentColor"/><path d="M12 12v10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
---
<Base>
  <!-- Hero -->
  <section class="hero torn-bottom">
    <img class="hero-img" src={url('/images/hero-dynamisk.jpg')} alt="" fetchpriority="high" />
    <div class="wrap hero-inner">
      <h1>Sportsskyting <em>i Namdalen</em></h1>
      <p class="hero-lead">Baneskyting, feltpistol og dynamisk sportsskyting med pistol, rifle og PCC – for alle fra nybegynnere til landslagsskyttere.</p>
      <div class="hero-actions">
        <a class="btn" href={url('/sikkerhetskurs/')}>
          Bli med
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="icon-link" href={url('/oppmoteregistrering/')}>
          <span class="dot"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
          <span>På trening i dag?<small>Registrer oppmøte</small></span>
        </a>
      </div>
      <div class="hero-bottom">
        <ul class="facts">
          <li><strong>1973</strong><span>Stiftet</span></li>
          <li><strong>5</strong><span>Skytegrener</span></li>
          <li><strong>2</strong><span>Skytebaner</span></li>
        </ul>
        <div class="badge">
          <img src={url('/images/nsf.png')} alt="" width="40" height="40" />
          <img src={url('/images/dssn.png')} alt="" width="40" height="40" />
          <span>Tilknyttet NSF og DSSN</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Om klubben -->
  <section class="section">
    <div class="wrap about">
      <div class="about-img torn-bottom torn-top" style="--torn-color: var(--paper)">
        <img src={url('/images/felt.jpg')} alt="Feltskyting på Øysletta" loading="lazy" />
      </div>
      <div class="about-text">
        <p class="eyebrow">Om</p>
        <h2><em>Namdal Sportsskytterlag</em></h2>
        <p class="muted">Vi er en skytterklubb i Namdalen i Trøndelag med medlemmer fra hobbyskyttere til landslagsutøvere. Vi er den eneste pistolklubben i Nord-Trøndelag som er tilknyttet Dynamisk Sportsskyting Norge.</p>
        <a class="btn" href={url('/om-2/')}>
          Les mer
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <div class="values">
          <div>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
            <h3>Sikkerhet først</h3>
            <p class="muted">Opplæring og veiledning gir trygg våpenhåndtering.</p>
          </div>
          <div>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>
            <h3>Skyteglede for alle</h3>
            <p class="muted">Et inkluderende miljø på tvers av alder og nivå.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skytegrener (skrå fotokort) -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Skytegrener</p><h2><em>Finn din gren</em></h2></div>
        <p class="muted">Fra rolig presisjon på 25 meter til hurtige stager i terrenget – vi har et tilbud som passer deg.</p>
      </div>
      <div class="fan">
        {sports.map((s) => (
          <a class:list={['fan-card', { featured: s.featured }]} href={url(s.href)} style={`--tilt:${s.tilt}deg`}>
            <img src={url(s.img)} alt="" loading="lazy" />
            <div class="fan-caption">
              <span class="tag">{s.org}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Skytebaner (skog-seksjon med nålede polaroider) -->
  <section class="forest torn-top torn-bottom" style="--torn-color: var(--paper)">
    <div class="wrap forest-inner">
      <div class="forest-text">
        <p class="eyebrow">Oppdag</p>
        <h2><em>Våre skytebaner</em></h2>
        <p>To baner gir gode forhold for presisjon, felt og dynamisk skyting hele året.</p>
      </div>
      <div class="polaroids">
        {ranges.map((r) => (
          <a class="polaroid" href={url(r.href)} style={`--tilt:${r.tilt}deg`}>
            <Fragment set:html={pin} />
            <img src={url(r.img)} alt={`Skytebanen ${r.name}`} loading="lazy" />
            <h3>{r.name}</h3>
            <p class="muted">{r.where}</p>
            <p>{r.text}</p>
            <span class="more">Les mer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Nyheter -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Aktuelt</p>
        <h2><em>Siste nytt fra klubben</em></h2>
      </div>
      <div class="grid grid-3">{latest.map((p) => <PostCard post={p} />)}</div>
      <p class="center" style="margin-top:32px"><a class="btn" href={url('/nyheter/')}>Alle nyheter</a></p>
    </div>
  </section>

  <!-- Ny skytter -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cta">
        <img src={url('/images/bane.jpg')} alt="" loading="lazy" />
        <div class="cta-text">
          <h2>Ny skytter? <em>Start med sikkerhetskurs</em></h2>
          <p>Kurset gir deg sikkerhetsregler, våpenlov og grunnleggende skyteteknikk. Etterpå kan du låne klubbens våpen.</p>
          <a class="btn" href={url('/sikkerhetskurs/')}>Meld deg på</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { --torn-color: var(--paper); position: relative; min-height: min(100vh, 860px); display: flex; color: var(--ink-invert); background: var(--night); overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, var(--scrim-strong) 0%, var(--scrim) 55%, transparent 100%); }
  .hero-inner { position: relative; z-index: 2; width: 100%; display: flex; flex-direction: column; justify-content: center; padding-top: 140px; padding-bottom: 90px; }
  .hero h1 { max-width: 12ch; margin-bottom: 20px; }
  .hero-lead { font-size: clamp(1.05rem, 1.8vw, 1.2rem); max-width: 44ch; color: var(--ink-invert-soft); margin: 0 0 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-top: clamp(48px, 9vw, 110px); }
  .facts { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 16px 56px; }
  .facts li { display: flex; flex-direction: column; }
  .facts strong { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 500; line-height: 1.1; }
  .facts span { color: var(--ink-invert-soft); font-size: .95rem; }
  .badge { display: flex; align-items: center; gap: 8px; padding: 12px 18px 12px 12px; border-radius: var(--radius-l); background: var(--glass); border: 1px solid var(--glass-line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); font-size: .95rem; }
  .badge img { width: 40px; height: 40px; border-radius: 50%; background: var(--card); padding: 3px; object-fit: contain; }
  .badge span { margin-left: 6px; }

  /* Om */
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 96px); align-items: center; }
  .about-img { border-radius: 4px; overflow: hidden; }
  .about-img img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .about-text .btn { margin: 8px 0 36px; }
  .values { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .values svg { color: var(--ink); }
  .values h3 { font-size: 1.05rem; margin: 10px 0 4px; }
  .values p { margin: 0; font-size: .95rem; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } }

  /* Skrå fotokort */
  .fan { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; padding: 24px 12px; }
  .fan-card { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: var(--radius-l); overflow: hidden; border: 6px solid var(--card); box-shadow: var(--shadow); transform: rotate(var(--tilt)); margin: 0 8px; transition: transform .25s, z-index 0s; color: var(--ink-invert); text-decoration: none; }
  .fan-card:hover, .fan-card:focus-visible { transform: rotate(0deg) translateY(-10px) scale(1.04); z-index: 3; color: var(--ink-invert); }
  .fan-card img { width: 100%; height: 100%; object-fit: cover; }
  .fan-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--scrim-strong) 0%, transparent 55%); }
  .fan-caption { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 18px; }
  .fan-caption h3 { margin: 8px 0 2px; font-size: 1.25rem; }
  .fan-caption p { margin: 0; font-size: .9rem; color: var(--ink-invert-soft); }
  @media (max-width: 860px) { .fan { grid-template-columns: 1fr 1fr; gap: 24px 0; } }
  @media (max-width: 480px) { .fan { grid-template-columns: 1fr; padding: 8px 20px; } .fan-card { aspect-ratio: 4 / 3; margin: 0; } }

  /* Skog-seksjon */
  .forest { --torn-color: var(--paper); background: var(--forest); color: var(--ink-invert); padding: clamp(90px, 11vw, 140px) 0; }
  .forest .eyebrow { color: var(--ink-invert); }
  .forest-inner { display: grid; grid-template-columns: 1fr 1.5fr; gap: 48px; align-items: center; }
  .forest-text p:last-child { color: var(--ink-invert-soft); max-width: 36ch; }
  .polaroids { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .polaroid { position: relative; display: block; background: var(--card); color: var(--ink); text-decoration: none; padding: 12px 12px 18px; border-radius: 6px; box-shadow: var(--shadow); transform: rotate(var(--tilt)); transition: transform .25s; }
  .polaroid:hover { transform: rotate(0deg) translateY(-6px); color: var(--ink); }
  .polaroid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; }
  .polaroid h3 { margin: 14px 4px 0; font-family: var(--font-head); font-style: italic; font-weight: 400; font-size: 1.5rem; }
  .polaroid p { margin: 2px 4px 0; font-size: .92rem; }
  .polaroid .more { display: inline-block; margin: 10px 4px 0; font-size: .9rem; font-weight: 500; color: var(--link); }
  .polaroid :global(.pin) { position: absolute; top: -14px; left: 50%; translate: -50% 0; color: var(--highlight); z-index: 2; filter: drop-shadow(0 2px 2px var(--shadow-color)); }
  @media (max-width: 860px) { .forest-inner { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .polaroids { grid-template-columns: 1fr; } }

  /* CTA */
  .cta { position: relative; display: grid; grid-template-columns: 1fr 1fr; border-radius: var(--radius-xl); overflow: hidden; background: var(--night-soft); color: var(--ink-invert); }
  .cta img { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .cta-text { padding: clamp(32px, 5vw, 64px); align-self: center; }
  .cta-text h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .cta-text p { color: var(--ink-invert-soft); max-width: 42ch; margin: 0 0 24px; }
  @media (max-width: 760px) { .cta { grid-template-columns: 1fr; } .cta img { aspect-ratio: 16 / 9; } }
</style>
