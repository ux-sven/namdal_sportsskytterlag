---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { posts, url } from '../lib/site.js';
const latest = posts.slice(0, 3);
const sports = [
  { title: 'Baneskyting', org: 'NSF', img: '/images/bane.jpg', href: '/norges-sportsskytterforbund/',
    text: 'Nybegynnervennlig presisjons- og hurtigskyting på 25 meter. Nivåklasser gir alltid jevngode konkurrenter.' },
  { title: 'Feltskyting', org: 'NSF', img: '/images/felt.jpg', href: '/norges-sportsskytterforbund/',
    text: 'Skyting på ukjente avstander og ulike mål i terrenget – variasjon og utfordring, også med optikk.' },
  { title: 'Dynamisk sportsskyting', org: 'DSSN', img: '/images/hero-dynamisk.jpg', href: '/dynamisk-sportsskyting/',
    text: 'Handgun, Rifle og PCC. Skytteren er i bevegelse og løser stager i høyt tempo med strenge sikkerhetskrav.' },
];
---
<Base>
  <section class="hero">
    <img class="hero-img" src={url('/images/hero-dynamisk.jpg')} alt="" fetchpriority="high" />
    <div class="wrap hero-inner">
      <p class="eyebrow">Namdal Sportsskytterlag · siden 1973</p>
      <h1>Sportsskyting i Namdalen</h1>
      <p class="hero-lead">Baneskyting, feltpistol og dynamisk sportsskyting med pistol, rifle og PCC – for alle fra nybegynnere til landslagsskyttere.</p>
      <div class="hero-actions">
        <a class="btn btn-light" href={url('/sikkerhetskurs/')}>Bli med – ta sikkerhetskurs</a>
        <a class="btn btn-ghost" href={url('/kalender/')}>Se aktiviteter</a>
      </div>
      <ul class="facts">
        <li><strong>1973</strong><span>stiftet</span></li>
        <li><strong>2 baner</strong><span>Bergsmo og Øysletta</span></li>
        <li><strong>NSF og DSSN</strong><span>tilknyttet begge forbund</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Aktuelt</p><h2>Siste nytt fra klubben</h2></div>
        <a href={url('/nyheter/')}>Alle nyheter →</a>
      </div>
      <div class="grid grid-3">{latest.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Skytesporter</p><h2>Finn din skytegren</h2></div>
        <a href={url('/vare-skytesporter/')}>Om skytesportene →</a>
      </div>
      <div class="grid grid-3">
        {sports.map((s) => (
          <a class="card" href={url(s.href)}>
            <div class="card-media"><img src={url(s.img)} alt="" loading="lazy" /></div>
            <div class="card-body">
              <span class="tag" style="align-self:flex-start">{s.org}</span>
              <h3>{s.title}</h3>
              <p class="muted" style="margin:0">{s.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap ranges">
      <div>
        <p class="eyebrow">Skytebaner</p>
        <h2>To baner – vinter og sommer</h2>
        <p class="muted">Klubben disponerer en innendørsbane på Bergsmo og en utendørsbane på Øysletta. Det gir gode forhold for både presisjon, felt og dynamisk skyting hele året.</p>
      </div>
      <div class="range-cards">
        <article class="range">
          <img src={url('/images/bergsmo.jpg')} alt="Innendørsbanen på Bergsmo" loading="lazy" />
          <div><h3>Bergsmo</h3><p class="muted">Innendørs 25-metersbane med elektroniske skiver. Her trener vi i vinterhalvåret.</p></div>
        </article>
        <article class="range">
          <img src={url('/images/oysletta.jpg')} alt="Utendørsbanen på Øysletta" loading="lazy" />
          <div><h3>Øysletta</h3><p class="muted">Utendørsbane ca. 30 km fra Namsos – ideell for feltskyting og dynamisk sportsskyting om sommeren.</p><a href={url('/oysletta-skytterbane/')}>Les om Øysletta →</a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap cta-grid">
      <div>
        <h2>Ny skytter?</h2>
        <p>Alle som vil begynne med pistolskyting tar vårt sikkerhetskurs først. Vi låner ut våpen til medlemmer som har fullført kurset.</p>
        <a class="btn btn-light" href={url('/sikkerhetskurs/')}>Meld deg på sikkerhetskurs</a>
      </div>
      <div>
        <h2>På trening i dag?</h2>
        <p>Registrer oppmøtet ditt – det tar ti sekunder. Skyteleder velges én gang per trening.</p>
        <a class="btn btn-ghost" href={url('/oppmoteregistrering/')}>Registrer oppmøte</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; color: #fff; background: var(--surface-dark); overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10, 18, 34, .92) 0%, rgba(10, 18, 34, .7) 45%, rgba(10, 18, 34, .25) 100%); }
  .hero-inner { position: relative; z-index: 1; padding-top: clamp(72px, 12vw, 160px); padding-bottom: clamp(48px, 8vw, 96px); }
  .hero .eyebrow { color: #a4bcfd; }
  .hero h1 { max-width: 14ch; margin-bottom: 16px; }
  .hero-lead { font-size: clamp(1.05rem, 2vw, 1.3rem); max-width: 46ch; color: #e4e7ec; margin: 0 0 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .facts { list-style: none; padding: 0; margin: clamp(40px, 7vw, 80px) 0 0; display: flex; flex-wrap: wrap; gap: 16px 48px; }
  .facts li { display: flex; flex-direction: column; }
  .facts strong { font-family: var(--font-head); font-weight: 400; font-size: 1.6rem; }
  .facts span { color: #d0d5dd; font-size: .95rem; }

  .ranges { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; align-items: start; }
  .range-cards { display: grid; gap: 20px; }
  .range { display: grid; grid-template-columns: 200px 1fr; gap: 20px; align-items: center; border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; padding-right: 20px; }
  .range img { width: 100%; height: 100%; min-height: 150px; object-fit: cover; }
  .range h3 { margin: 0 0 4px; }
  .range p { margin: 0 0 6px; }
  @media (max-width: 860px) { .ranges { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .range { grid-template-columns: 1fr; padding: 0 0 16px; } .range > div { padding: 0 18px; } .range img { aspect-ratio: 16/9; } }

  .cta-band { background: var(--cta); color: #fff; padding: clamp(48px, 7vw, 80px) 0; }
  .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .cta-grid p { color: #dbe5fb; max-width: 44ch; }
  @media (max-width: 760px) { .cta-grid { grid-template-columns: 1fr; } }
</style>
