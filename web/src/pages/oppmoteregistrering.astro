---
import Base from '../layouts/Base.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
import { url } from '../lib/site.js';
---
<Base title="Oppmøteregistrering" description="Registrer oppmøte på skytetrening i Namdal Sportsskytterlag.">
  <section class="page-hero torn-bottom">
    <img class="page-hero-img" src={url('/images/bergsmo.jpg')} alt="" />
    <div class="wrap">
      <p class="eyebrow">For medlemmer og gjester</p>
      <h1>Registrer <em>oppmøte</em></h1>
      <p id="lead">Registrer deg når du er på trening. Skyteleder velges av første skytter og huskes resten av dagen.</p>
    </div>
  </section>

  <section class="section reg-section">
    <RegistrationForm />
    <div class="kiosk-cta">
      <a class="btn btn-ghost-dark" href={url('/oppmoteregistrering/nettbrett/')} target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M11 18h2"/></svg>
        Åpne nettbrettmodus
      </a>
    </div>
  </section>
</Base>
