---
const { size = 40 } = Astro.props;
---
<svg class="logo" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <circle cx="24" cy="24" r="24" style="fill:var(--accent)" />
  <g fill="none" style="stroke:var(--on-accent)" stroke-width="3"><circle cx="24" cy="24" r="14" /><circle cx="24" cy="24" r="8" /></g>
  <circle cx="24" cy="24" r="3" style="fill:var(--on-accent)" />
</svg>
